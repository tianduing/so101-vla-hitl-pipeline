# Fill these values on the physical Ubuntu controller. Stable by-id paths are preferred.
FOLLOWER_PORT=/dev/serial/by-id/REPLACE_WITH_FOLLOWER
FOLLOWER_ID=so101_follower_lab
LEADER_PORT=/dev/serial/by-id/REPLACE_WITH_LEADER
LEADER_ID=so101_leader_lab
FRONT_CAMERA=/dev/v4l/by-id/REPLACE_WITH_FRONT_CAMERA
WRIST_CAMERA=/dev/v4l/by-id/REPLACE_WITH_WRIST_CAMERA
TASK="Pick the instructed object and place it in the target region"
POLICY_PATH=models/checkpoints/smolvla_hitl/last/pretrained_model
